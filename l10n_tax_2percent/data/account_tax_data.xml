<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 2% Sales Tax for Spanish 303 reporting -->
        <record id="tax_sale_2percent" model="account.tax">
            <field name="name">IVA 2%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount">2</field>
            <field name="amount_type">percent</field>
            <field name="description">2%</field>
            <field name="tax_group_id" ref="l10n_es.tax_group_iva_2"/>
            <field name="invoice_repartition_line_ids" eval="[(5, 0, 0),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'base',
                    'tag_ids': [(6, 0, [ref('l10n_es.mod_303_base_2')])],
                }),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                    'account_id': ref('l10n_es.account_tax_sale_2'),
                    'tag_ids': [(6, 0, [ref('l10n_es.mod_303_cuota_2')])],
                })]"/>
            <field name="refund_repartition_line_ids" eval="[(5, 0, 0),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'base',
                    'tag_ids': [(6, 0, [ref('l10n_es.mod_303_base_2_refund')])],
                }),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                    'account_id': ref('l10n_es.account_tax_sale_2'),
                    'tag_ids': [(6, 0, [ref('l10n_es.mod_303_cuota_2_refund')])],
                })]"/>
        </record>

        <!-- 2% Purchase Tax -->
        <record id="tax_purchase_2percent" model="account.tax">
            <field name="name">Purchase Tax 2%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount">2</field>
            <field name="amount_type">percent</field>
            <field name="description">2%</field>
            <field name="tax_group_id" ref="account.tax_group_taxes"/>
            <field name="invoice_repartition_line_ids" eval="[(5, 0, 0),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'base',
                }),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                    'account_id': ref('account.expense_tax_account'),
                })]"/>
            <field name="refund_repartition_line_ids" eval="[(5, 0, 0),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'base',
                }),
                (0, 0, {
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                    'account_id': ref('account.expense_tax_account'),
                })]"/>
        </record>
    </data>
</odoo> 